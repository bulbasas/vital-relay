{
  "name": "vital-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source, zero-storage MCP relay between AI assistants and the Vital Relay iPhone app (Apple Health).",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/bulbasas/vital-relay.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit",
    "sim": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/simulate-iphone.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "probe": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/mcp-probe.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "^5.12.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
