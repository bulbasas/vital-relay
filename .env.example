# Public base URL of this relay (used to build MCP URLs shown in the app)
PUBLIC_URL=https://pulse.impulsera.lt
PORT=8083
HOST=0.0.0.0
# SQLite file for devices / connections / waitlist (never health data)
DB_PATH=./data/relay.sqlite
# How long a tools/call waits for the phone before returning "pending" (ms).
# Claude allows 240 s per tool call; ChatGPT reportedly ~60 s.
LIVE_TIMEOUT_MS=20000
APPROVAL_WAIT_MS=40000
# Pending answers are kept in RAM for the AI to pick up, then dropped (ms)
PENDING_TTL_MS=600000
# APNs (Phase 2 — leave empty to disable push)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_TOPIC=
APNS_ENV=sandbox
# Dev only: let devices without Pro use push wake (true/false)
DEV_PUSH_FOR_ALL=false
